<UserControl x:Class="DBDOverlay.UI.Tabs.ReshadeTabView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:custom="clr-namespace:DBDOverlay.Core.CustomItems"
 Background="{DynamicResource DarkestGrayBrush}">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="14,10,14,20">
   <TextBlock Text="ReShade integration" Foreground="White" FontSize="23" FontWeight="SemiBold"/>
   <TextBlock Text="Prepare the right filter for each map, then reload it your way." Foreground="{DynamicResource LightGrayBrush}" TextWrapping="Wrap" Margin="0,6,0,18"/>
   <Border Background="{DynamicResource DarkGrayBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,12">
    <StackPanel>
     <TextBlock Text="1 · Presets and maps" Foreground="White" FontSize="16" Margin="0,0,0,8"/>
     <custom:ReadOnlyTextBox x:Name="ReShadePathTextBox" IsReadOnly="True" Style="{StaticResource TextBoxReadOnlyStyle}" MinHeight="32" ToolTip="Preset folder"/>
     <WrapPanel Margin="0,8,0,8">
      <Button Content="Choose folder" Click="OpenFolder_Click" Style="{StaticResource ButtonBackStyle}" Width="110" Height="32" Margin="0,0,8,4"/>
      <Button Content="Refresh" Click="RefreshFilters_Click" Style="{StaticResource ButtonBackStyle}" Width="80" Height="32" Margin="0,0,8,4"/>
      <Button Content="Disconnect" Click="ClearFolder_Click" Style="{StaticResource ButtonBackStyle}" Width="95" Height="32" Margin="0,0,8,4" ToolTip="Disconnect this folder without deleting any presets"/>
     </WrapPanel>
     <DockPanel>
      <Button x:Name="AssignFiltersButton" Content="Assign maps" Click="AssignFilters_Click" DockPanel.Dock="Right" Style="{StaticResource ButtonStyle}" Width="110" Height="32"/>
      <TextBlock x:Name="FiltersStatusLabel" Foreground="{DynamicResource LightGrayBrush}" VerticalAlignment="Center"/>
     </DockPanel>
     <TextBlock Text="Overlay preset" Foreground="White" Margin="0,12,0,5"/>
     <DockPanel>
      <Button x:Name="GenerateFilterButton" Content="Create preset" Click="GenerateFilter_Click" DockPanel.Dock="Right" Style="{StaticResource ButtonBackStyle}" Width="110" Height="32" Margin="8,0,0,0"/>
      <TextBox x:Name="MainFilterNameTextBox" Style="{StaticResource TextBoxInputStyle}" MinHeight="32" MaxLength="80"/>
     </DockPanel>
    </StackPanel>
   </Border>
   <Border Background="{DynamicResource DarkGrayBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,12">
    <StackPanel>
     <TextBlock Text="2 · Apply the filter" Foreground="White" FontSize="16" Margin="0,0,0,8"/>
     <DockPanel Margin="0,0,0,8">
      <custom:CustomToggleButton x:Name="AutoApplyToggle" DockPanel.Dock="Right" Style="{StaticResource ToggleButtonStyle}" Checked="AutoApply_Changed" Unchecked="AutoApply_Changed"/>
      <TextBlock Text="Auto-apply on map detection" Foreground="White" VerticalAlignment="Center"/>
     </DockPanel>
     <TextBlock Text="Sends the configured reload key only while DBD is in front. Select your overlay preset in ReShade and use F1–F24 without Ctrl, Shift or Alt. F10 still works manually." Foreground="{DynamicResource LightGrayBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
     <DockPanel>
      <Button Content="ReShade.ini" Click="SelectConfig_Click" DockPanel.Dock="Right" Style="{StaticResource ButtonBackStyle}" Width="110" Height="32" Margin="8,0,0,0"/>
      <custom:ReadOnlyTextBox x:Name="ConfigPathTextBox" IsReadOnly="True" Style="{StaticResource TextBoxReadOnlyStyle}" MinHeight="32"/>
     </DockPanel>
     <Button Content="Reload prepared preset" Click="ApplyNow_Click" Style="{StaticResource ButtonStyle}" Width="190" Height="34" HorizontalAlignment="Left" Margin="0,10,0,0" ToolTip="Return to DBD within 30 seconds; the reload key will be sent once"/>
    </StackPanel>
   </Border>
   <Border BorderBrush="{DynamicResource GrayBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
    <StackPanel>
     <TextBlock Text="Current status" Foreground="White" FontSize="16" Margin="0,0,0,8"/>
     <TextBlock x:Name="ActiveMap" Foreground="{DynamicResource LightGrayBrush}" TextWrapping="Wrap"/>
     <TextBlock x:Name="ActiveFilter" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,8"/>
     <TextBlock x:Name="ApplyStatus" Foreground="{DynamicResource LightGrayBrush}" TextWrapping="Wrap"/>
    </StackPanel>
   </Border>
  </StackPanel>
 </ScrollViewer>
</UserControl>
