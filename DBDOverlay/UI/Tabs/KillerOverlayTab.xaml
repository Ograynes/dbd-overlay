<UserControl x:Class="DBDOverlay.UI.Tabs.KillerOverlayTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DBDOverlay.UI.Tabs"
             xmlns:custom="clr-namespace:DBDOverlay.Core.CustomItems"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="500"
             Background="{DynamicResource DarkestGrayBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="14,10,14,20">
        <TextBlock Text="Survivor tracking" Foreground="White" FontSize="23" FontWeight="SemiBold"/>
        <TextBlock Text="Calibrate once for your HUD, then verify detection in a custom match." Foreground="{DynamicResource LightGrayBrush}" TextWrapping="Wrap" Margin="0,6,0,12"/>
        <WrapPanel Margin="0,8">
            <Button Content="Calibrate region" Click="Calibrate_Click" Margin="0,4,8,4" Width="130" Height="34" Style="{StaticResource ButtonStyle}"/>
            <Button Content="Learn unhooked state" Click="LearnUnhooked_Click" Margin="0,4,8,4" Width="160" Height="34" Style="{StaticResource ButtonBackStyle}"/>
            <Button Content="Reset calibration" Click="ResetCalibration_Click" Margin="0,4,8,4" Width="130" Height="34" Style="{StaticResource ButtonBackStyle}"/>
        </WrapPanel>
        <TextBlock Text="Calibrate the state column, then learn visible unhooked states. Unknown images never start a timer. Reset calibration also clears learned images for this mode."
                   Foreground="White" TextWrapping="Wrap" Margin="4"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.4*"/>
                <ColumnDefinition Width="0.6*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="45"/>
                <RowDefinition Height="45"/>
                <RowDefinition Height="45"/>
                <RowDefinition Height="45"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Hooks"
                       Style="{StaticResource TextBlockStyle}"/>

            <TextBlock Grid.Row="1"
                       Text="Post unhook timer"
                       Style="{StaticResource TextBlockStyle}"/>

            <TextBlock Grid.Row="2"
                       Text="2v8 mode"
                       Style="{StaticResource TextBlockStyle}"/>

            <TextBlock Grid.Row="3"
                       Text="Side panel"
                       Style="{StaticResource TextBlockStyle}"/>

            <custom:CustomToggleButton x:Name="HooksToggleButton"
                            Grid.Row="0"
                            Grid.Column="1"
                            HorizontalAlignment="Center"
                            Style="{StaticResource ToggleButtonStyle}"
                            Checked="Hooks_Checked"
                            Unchecked="Hooks_Unchecked"/>

            <custom:CustomToggleButton x:Name="PostUnhookTimerToggleButton"
                            Grid.Row="1"
                            Grid.Column="1"
                            HorizontalAlignment="Center"
                            Style="{StaticResource ToggleButtonStyle}"
                            Checked="PostUnhookTimer_Checked"
                            Unchecked="PostUnhookTimer_Unchecked"/>

            <custom:CustomToggleButton x:Name="Mode2v8ToggleButton"
                            Grid.Row="2"
                            Grid.Column="1"
                            HorizontalAlignment="Center"
                            Style="{StaticResource ToggleButtonStyle}"
                            Checked="Mode2v8_Checked"
                            Unchecked="Mode2v8_Unchecked"/>

            <custom:CustomToggleButton x:Name="SidePanelToggleButton"
                            Grid.Row="3"
                            Grid.Column="1"
                            HorizontalAlignment="Center"
                            Style="{StaticResource ToggleButtonStyle}"
                            Checked="SidePanel_Checked"
                            Unchecked="SidePanel_Unchecked"/>
        </Grid>

        <Button x:Name="ResetButton"
                Style="{StaticResource ButtonStyle}"
                Content="Reset values"
                FontSize="14"
                Foreground="White"
                HorizontalAlignment="Center"
                Width="90"
                Height="30"
                Click="Reset_Click"
                Margin="0,5,0,0"/>

        <TextBlock Text="Overlay Configuration"
                   Foreground="White"
                   FontSize="22"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Margin="0,20,0,10"/>


        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center">
            <TextBlock Text="Threshold"
                       FontSize="16"
                       Margin="0,0,20,0"
                       Style="{StaticResource TextBlockStyle}"/>
            <Slider x:Name="ThresholdSlider"
                    VerticalAlignment="Center"
                    Width="140"
                    ValueChanged="Slider_ValueChanged"
                    Maximum="100"
                    IsSnapToTickEnabled="True"
                    Style="{StaticResource Horizontal_Slider}"/>
            <TextBox x:Name="ThresholdTextBox"
                     Text="{Binding ElementName=ThresholdSlider,
                            Path=Value,
                            UpdateSourceTrigger=PropertyChanged}"
                     VerticalAlignment="Center"
                     Width="44"
                     Height="30"
                     Margin="10,0,0,3"
                     FontSize="20"
                     TextAlignment="Center"
                     Style="{StaticResource TextBoxInputStyle}"/>
            <Label Content="%"
                   Foreground="White"
                   FontSize="18"
                   VerticalAlignment="Center"/>
            <Button x:Name="ResetThresholdButton"
                    Style="{StaticResource ButtonStyle}"
                    Content="Reset"
                    FontSize="14"
                    Foreground="White"
                    Width="60"
                    Height="30"
                    Margin="20,0,0,0"
                    Click="ResetThreshold_Click"/>
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</UserControl>
